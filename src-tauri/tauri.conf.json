{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitGoblin",
  "version": "0.1.0",
  "identifier": "dev.gitgoblin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "GitGoblin",
        "decorations": false,
        "width": 1500,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 650,
        "backgroundColor": "#101114"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:* ws://[::1]:*"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"] }
}
